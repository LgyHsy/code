    bool "MYQ12"
    help
        Select MYQ12 Project.

config MYF31H
    bool "MYF31H"
    help
        Select MYF31H Project.

config D72W
    bool "D72W"
    help
        Select D72W Project.

config TCL12Q
    bool "TCL12Q"
    help
        Select TCL12Q Project.

config TCA55
    bool "TCA55"
    help
        Select TCA55 Project.

config TYE40H
    bool "TYE40H"
    help
        Select TYE40H Project.
endchoice

config BUILD_PROJECT_NAME
    string
    default "MYF30" if MYF30
    default "MYQ12" if MYQ12
    default "MYF31H" if MYF31H
    default "D72W" if D72W
    default "TCL12Q" if TCL12Q
    default "TCA55" if TCA55
    default "TYE40H" if TYE40H

# 调试选项
config DEBUG
    bool "Enable Debug"
    default n                                                                              
    help
        Enable debug output and features.

config PQTOOL
    bool "Enable PQ Tool mode"
    default n
    help
        Skip ispctl overlay of brightness/contrast/AE so PQTOOL can tune ISP.
        Soft-photosensor day/night PQ bin switch still works.

# 模块配置
menu "Module Configuration"

config MODULE_PTZ
    bool "Enable PTZ"
    default y
    help
        Enable PTZ functionality.

    if MODULE_PTZ
        choice
            prompt "PTZ Control Method"
            optional
            help
                Select the PTZ control method (mutually exclusive)
            config MODULE_PTZ_DRV
                bool "PTZ DRV Control"
                help
                    Enable core PTZ drv control

            config MODULE_PTZ_PWM
                bool "PTZ PWM Control"
                help
                    Enable core PTZ PWM control

            config MODULE_PTZ_IIC
                bool "PTZ IIC Control"
                help
                    Enable core PTZ IIC control
        endchoice
    endif

config MODULE_SDCARD
    bool "Enable SD Card"
    default y
    help
        Enable SD card functionality.

choice
    prompt "Flash Type"
    default FLASH_TYPE_NOR
    help
        Select SPI NOR or SPI NAND flash layout.

    config FLASH_TYPE_NOR
        bool "SPI NOR"

    config FLASH_TYPE_NAND
        bool "SPI NAND"
endchoice

config MODULE_NFS
    bool "Enable NFS Network Storage"
    default n
    help
        Enable NFS network storage recording.

config MODULE_MCU
    bool "Enable MCU"
    default n
    help
        Enable mcu functionality.

config MODULE_AOV
    bool "Enable AOV"
    default n
    help
        Enable aov functionality.

config MODULE_ZXING
    bool "Enable ZXING"
    default y
    help
        Enable ZXING functionality.

config MODULE_WAVE
    bool "Enable WAVE"
    default y
    help
        Enable WAVE functionality.

config MODULE_BATTERY
    bool "Enable Battery"
    default y
    help
        Enable Battery functionality.

config MODULE_GYRO
    bool "Enable Gyro"
    default n
    help
        Enable gyro functionality.

    if MODULE_GYRO
        choice
            prompt "Gyro Sensor Chip"
            default MODULE_GYRO_ICM42607P
            help
                Select the gyro sensor chip driver (mutually exclusive)

            config MODULE_GYRO_ICM42607P
                bool "ICM42607P"
                help
                    Enable ICM42607P gyro/accel sensor driver
        endchoice
    endif

config MODULE_BLUETOOTH
    bool "Enable Bluetooth"
    default n
    help
        Enable Bluetooth functionality.

