    string "Project SDK path"
    default "../build/MYF30/release/project" if mstar_i6c

config BUILD_COMPILER
    string "COMPILER"
    default "arm-sigmastar-linux-uclibcgnueabihf-" if mstar_i6c
    default "arm-linaro-linux-uclibcgnueabihf-" if mstar_i6c
    default "arm-ts-linux-uclibcgnueabihf-" if ts_5326

config SDK_LIBS_STATIC
    bool "Static Link SDK Libs"
    default y
    help
        Enable Static Link SDK Libs.

config TS_SENSOR
    string "TS ISP sensor lib set"
    depends on ts_5326
    default "os05a20"
    help
        Name of middleware/platforms/ts_5326/sensors/<name>.cmake.
