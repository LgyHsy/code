# Snap 抓拍：软编/硬编互斥，可不选
choice
    prompt "Snap Encode Method"
    optional
    default MODULE_SNAP_SOFT
    help
        Soft and hard JPEG snap are mutually exclusive. Leave unset to disable snap.

    config MODULE_SNAP_SOFT
        bool "Soft JPEG (libjpeg)"
        help
            Soft encode via libjpeg from YUV.

    config MODULE_SNAP_HARD
        bool "Hard JPEG (VENC)"
        depends on ts_5326
        help
            Hard encode via SoC VENC JPEG.
endchoice

# Smart菜单
config MODULE_SMART
    bool "Enable Smart"
    default y
    help
        Enable Smart.

    if MODULE_SMART
    config MODULE_SMART_MD
        bool "Enable Smart Md"
        default y
        help
            Add motion detect.

    config MODULE_SMART_PD
        bool "Enable Smart Pd"
        default y
        help
            Add person detect.

    config MODULE_SMART_FD
        bool "Enable Smart Fd"
        depends on ts_5326
        default n
        help
            Add face detect (ts_5326 only).

    config MODULE_SMART_PVD
        bool "Enable Smart Pvd"
        depends on ts_5326
        default n
        help
            Add person/vehicle/non-motor detect (PVD via algmod8c, replaces bodydetect PD on ts_5326).
    endif

# Service子菜单
menu "Service Options"
config MODULE_SREVICE_28181
    bool "Enable 28181 Protocol"
    default n
    help
        Enable GB/T 28181 protocol support.

config MODULE_SREVICE_ONVIF
    bool "Enable ONVIF Protocol"
    default y
    help
        Enable ONVIF protocol support.

    if MODULE_SREVICE_ONVIF
    choice
        prompt "ONVIF Version"
        default ONVIF_VERSION_SIMPLE
        help
            Select ONVIF protocol version.

    config ONVIF_VERSION_SIMPLE
        bool "Simple Version"
        help
            Enable simple ONVIF protocol with basic functions.

    config ONVIF_VERSION_FULL
        bool "Full Version"
        help
            Enable full ONVIF protocol with all functions.

    endchoice
    endif

config MODULE_SREVICE_HIK
    bool "Enable Hikvision Private Protocol (SADP + cmd port)"
    default n
    help
        Enable in-process Hikvision NVR docking (SADP discovery and private command port).
        RTSP streaming reuses MODULE_SREVICE_RTSP_LITE / RTSP.

config MODULE_SREVICE_RTSP_ENABLE
    bool "Enable RTSP Protocol"
    default n
    help
        Enable RTSP protocol and choose one protocol implementation.

if MODULE_SREVICE_RTSP_ENABLE
    choice
        prompt "RTSP Protocol"
        default MODULE_SREVICE_RTSP_LITE
        help
            Select exactly one RTSP protocol implementation.

    config MODULE_SREVICE_RTSP
        bool "Enable RTSP Protocol"
        help
            Enable RTSP protocol support.

    config MODULE_SREVICE_RTSP_LITE
        bool "Enable RTSP_LITE Protocol"
        help
            Enable RTSP_LITE protocol support.
            RTSP_LITE (vs RTSP): 
              anjcam: -192408 bytes    
              MemAvailable: +240 KB    
              rootfs.sqfs: -98304 bytes

    endchoice
endif

config MODULE_SREVICE_ANJSER
    bool "Enable ANJ Service"
    default y
    help
        Enable ANJ Service support.
    if MODULE_SREVICE_ANJSER
    choice
        prompt "ANJ Service Type"
        default AIOT_SERVER
        
        config AIOT_SERVER
            bool "Enable AIOT Server"
            help
                Enable AIOT Server support.
        config ALI_SERVER
            bool "Enable ALI Server"
            help
                Enable ALI Server support.
    endchoice

    config MODULE_CLOUD_STORAGE
        bool "Enable Cloud Storage"
        default n
        depends on MODULE_SREVICE_ANJSER
        help
            Enable Cloud Storage functionality.
    
    if MODULE_CLOUD_STORAGE
        choice
            prompt "Cloud Storage Type"
            default AIOT_CLOUD_STORAGE
            help
                Select cloud storage service type

            config CT_CLOUD_STORAGE
                bool "CT Cloud Storage"
                help
                    Enable CT Cloud Storage service.

            config AIOT_CLOUD_STORAGE
                bool "AIOT Cloud Storage"
                help
                    Enable AIOT Cloud Storage service.
        endchoice
    endif
    endif

config MODULE_SREVICE_ANJWEB
    bool "Enable ANJ WEB"
    default n
    help
        Enable ANJ Web support.

config MODULE_SREVICE_H5LIVE
    bool "Enable H5 Live WebSocket Preview"
    default n
    help
        Enable H5 WebSocket live preview and playback service.

config MODULE_SREVICE_RTMP
    bool "Enable RTMP Publish Service"
    default n
    help
        Enable RTMP push streaming service in single-process mode.

config MODULE_SERVICE_HTTP
    bool "Enable HTTP Service"
    default n
    help
        Enable HTTP server for web interface and APIs.

config MODULE_SERVICE_FTPEMAIL
    bool "Enable FTP/Email Service"
    default n
    help
        Enable FTP and email file upload service.

# 自动启用机制
config MODULE_SERVICE_HTTP_AUTO
    bool
    default y if ONVIF_VERSION_FULL || MODULE_SREVICE_ANJWEB
    select MODULE_SERVICE_HTTP

endmenu

