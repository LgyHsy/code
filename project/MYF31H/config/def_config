# CONFIG_MYF30 is not set
# CONFIG_MYQ12 is not set
CONFIG_MYF31H=y
CONFIG_BUILD_PROJECT_NAME="MYF31H"
# CONFIG_DEBUG is not set

#
# Module Configuration
#
CONFIG_MODULE_PTZ=y
# CONFIG_MODULE_PTZ_DRV is not set
CONFIG_MODULE_PTZ_PWM=y
CONFIG_MODULE_SDCARD=y
CONFIG_FLASH_TYPE_NOR=y
# CONFIG_FLASH_TYPE_NAND is not set
# CONFIG_MODULE_MCU is not set
# CONFIG_MODULE_AOV is not set
CONFIG_MODULE_ZXING=y
CONFIG_MODULE_WAVE=y
# CONFIG_MODULE_BATTERY is not set
CONFIG_MODULE_BLUETOOTH=y

#
# media Options
#
CONFIG_MODULE_MEDIA_AUDIO=y
CONFIG_MODULE_MEDIA_MP3=y
CONFIG_MODULE_MEDIA_AAC=y
CONFIG_MODULE_AUDIO_ALGO_AEC=y
CONFIG_MODULE_MEDIA_OSD=y
CONFIG_MODULE_SNAP_SOFT=y
# CONFIG_MODULE_SNAP_HARD is not set
# end of media Options

CONFIG_MODULE_SMART=y
CONFIG_MODULE_SMART_MD=y
CONFIG_MODULE_SMART_PD=y

#
# Service Options
#
CONFIG_MODULE_SREVICE_28181=y
CONFIG_MODULE_SREVICE_ONVIF=y
CONFIG_ONVIF_VERSION_FULL=y
CONFIG_MODULE_SREVICE_RTSP_ENABLE=y
CONFIG_MODULE_SREVICE_RTSP=n
CONFIG_MODULE_SREVICE_RTSP_LITE=y
CONFIG_MODULE_SREVICE_ANJSER=y
CONFIG_AIOT_SERVER=y
# CONFIG_ALI_SERVER is not set
CONFIG_MODULE_CLOUD_STORAGE=y
# CONFIG_CT_CLOUD_STORAGE is not set
CONFIG_AIOT_CLOUD_STORAGE=y
# CONFIG_MODULE_SREVICE_ANJWEB is not set
# CONFIG_MODULE_SERVICE_HTTP is not set
# end of Service Options

#
# Net Options
#
CONFIG_MODULE_NET_WIRE=y
CONFIG_MODULE_NET_WIFI=y
# CONFIG_MODULE_NET_4G is not set
# end of Net Options
# end of Module Configuration

# CONFIG_mstar_i6c is not set
CONFIG_mstar_ifliegen=y
CONFIG_BUILD_PLATFORMS_NAME="mstar_ifliegen"
CONFIG_BUILD_PROJECT_SDK_PATH="../build/MYF31H/release/project"
CONFIG_BUILD_COMPILER="arm-linaro-linux-uclibcgnueabihf-"
CONFIG_SDK_LIBS_STATIC=y
