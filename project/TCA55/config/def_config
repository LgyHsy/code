CONFIG_AIOT_CLOUD_STORAGE=y
CONFIG_MODULE_SREVICE_ANJWEB=y
CONFIG_MODULE_SREVICE_H5LIVE=y
CONFIG_MODULE_SERVICE_HTTP=y
CONFIG_MODULE_SREVICE_RTMP=y
# end of Service Options

#
# Net Options
#
CONFIG_MODULE_NET_WIRE=y
# CONFIG_MODULE_NET_WIFI is not set
# CONFIG_MODULE_NET_4G is not set
# end of Net Options
# end of Module Configuration

